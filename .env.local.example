# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (server-only — never ship to the browser).
# Required by the admin dashboard for hard-deleting users, accepting
# invitations (creating users), and reading auth.users.last_sign_in_at.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend — sends invitation + access-granted emails. Free tier is 3,000/month.
# If RESEND_API_KEY is unset, email bodies print to the dev server console so
# you can copy/paste links during local testing without setting up Resend.
# RESEND_API_KEY=re_xxx
# INVITE_FROM_EMAIL=invites@yourdomain.com   # default: onboarding@resend.dev
