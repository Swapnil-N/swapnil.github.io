# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (server-only — never ship to the browser).
# Required by the admin dashboard for hard-deleting users, sending invite
# emails, and reading auth.users.last_sign_in_at.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
