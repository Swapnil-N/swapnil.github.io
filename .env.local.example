# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (server-only — never ship to the browser).
# Required by the admin dashboard for hard-deleting users, sending invitation
# emails (auth.admin.inviteUserByEmail), and reading auth.users.last_sign_in_at.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Invitation emails go through Supabase's built-in auth email infrastructure
# (no extra env var needed). Free tier rate-limits to 3 emails/hour. If you
# need higher throughput, configure a custom SMTP provider in the Supabase
# dashboard (Project Settings → Auth → SMTP). The /admin/invitations UI
# always shows a copyable /signup URL so admins can share the link manually
# when email delivery is rate-limited or skipped.
